cc_prebuilt_library_shared {
    name: "libnvram",
    owner: "mtk",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: ["proprietary/vendor/lib/libnvram.so"],
        },
        android_arm64: {
            srcs: ["proprietary/vendor/lib64/libnvram.so"],
        },
    },
    compile_multilib: "both",
    prefer: true,
    vendor: true,
}

